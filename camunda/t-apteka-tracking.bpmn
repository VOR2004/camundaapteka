<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_TApteka" targetNamespace="http://t-apteka.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="ApiBand" name="API" />
    <bpmn:participant id="Pool" name="Т-Аптеки — отслеживание заказа" processRef="t_apteka_tracking" />
    <bpmn:messageFlow id="ApiRequest" name="GET /orders/{orderId}" sourceRef="fetch" targetRef="ApiBand" />
    <bpmn:messageFlow id="ApiResponse" name="200 OK / JSON: status" sourceRef="ApiBand" targetRef="fetch" />
  </bpmn:collaboration>
  <bpmn:process id="t_apteka_tracking" name="Т-Аптеки: отслеживание статуса заказа" isExecutable="true">
    <bpmn:documentation>Учебный процесс отслеживания. Статус меняется во внешней системе (мок API); клиент вручную запрашивает обновления. REST Connector выполняется движком.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="LaneClient" name="Клиент">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refresh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneSystem" name="Т-Аптеки (система)">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTerminal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Запрос отслеживания">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="request" name="Запросить статус заказа">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="request_order" bindingType="latest" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="fetch" name="Получить статус через API">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="= (if apiBaseUrl = null then &#34;http://localhost:3001&#34; else apiBaseUrl) + &#34;/orders/&#34; + orderId" target="url" />
          <zeebe:input source="= {type: &#34;noAuth&#34;}" target="authentication" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="orderResponse" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="view" name="Просмотреть статус заказа">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="view_status" bindingType="latest" />
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="terminal" name="Заказ завершён?" default="f6">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endTerminal" name="Отслеживание завершено">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="continue" name="Продолжить отслеживание?" default="f8">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endClosed" name="Просмотр закрыт">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="refresh" name="Запросить обновление">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="refresh_order" bindingType="latest" />
      </bpmn:extensionElements>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="f2" sourceRef="request" targetRef="fetch" />
    <bpmn:sequenceFlow id="f9" sourceRef="refresh" targetRef="fetch" />
    <bpmn:sequenceFlow id="f3" sourceRef="fetch" targetRef="view" />
    <bpmn:sequenceFlow id="f4" sourceRef="view" targetRef="terminal" />
    <bpmn:sequenceFlow id="f5" name="Выдан / отменён" sourceRef="terminal" targetRef="endTerminal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= orderResponse.body.status = "DELIVERED" or orderResponse.body.status = "CANCELLED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="Нет" sourceRef="terminal" targetRef="continue" />
    <bpmn:sequenceFlow id="f7" name="Да" sourceRef="continue" targetRef="refresh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= continueTracking = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="Нет" sourceRef="continue" targetRef="endClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="ApiBand_di" bpmnElement="ApiBand" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1360" height="110" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1360" height="630" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneSystem_di" bpmnElement="LaneSystem" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="1330" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneClient_di" bpmnElement="LaneClient" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1330" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="300" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="284" y="625" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_di" bpmnElement="request">
        <dc:Bounds x="410" y="560" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch_di" bpmnElement="fetch">
        <dc:Bounds x="660" y="300" width="170" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="view_di" bpmnElement="view">
        <dc:Bounds x="910" y="560" width="170" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="terminal_di" bpmnElement="terminal" isMarkerVisible="true">
        <dc:Bounds x="1130" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="275" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endTerminal_di" bpmnElement="endTerminal">
        <dc:Bounds x="1330" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1310" y="370" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="continue_di" bpmnElement="continue" isMarkerVisible="true">
        <dc:Bounds x="1130" y="680" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1116" y="750" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endClosed_di" bpmnElement="endClosed">
        <dc:Bounds x="1330" y="687" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1303" y="735" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refresh_di" bpmnElement="refresh">
        <dc:Bounds x="910" y="665" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="336" y="600" />
        <di:waypoint x="410" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="490" y="560" />
        <di:waypoint x="490" y="340" />
        <di:waypoint x="660" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="910" y="705" />
        <di:waypoint x="745" y="705" />
        <di:waypoint x="745" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="830" y="340" />
        <di:waypoint x="995" y="340" />
        <di:waypoint x="995" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="1080" y="600" />
        <di:waypoint x="1105" y="600" />
        <di:waypoint x="1105" y="340" />
        <di:waypoint x="1130" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="1180" y="340" />
        <di:waypoint x="1330" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1222" y="312" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="1155" y="365" />
        <di:waypoint x="1155" y="680" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1173" y="505" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="1130" y="705" />
        <di:waypoint x="1080" y="705" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1098" y="682" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="1180" y="705" />
        <di:waypoint x="1330" y="705" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1248" y="682" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ApiRequest_di" bpmnElement="ApiRequest">
        <di:waypoint x="700" y="300" />
        <di:waypoint x="700" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="557" y="215" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ApiResponse_di" bpmnElement="ApiResponse">
        <di:waypoint x="790" y="160" />
        <di:waypoint x="790" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="827" y="215" width="112" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>